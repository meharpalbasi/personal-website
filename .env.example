# Notion Integration
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxx

# Notion database ID for blog posts
# Get from database URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=xxx

# Site URL (used for canonical URLs and OG images)
NEXT_PUBLIC_URL=http://localhost:3000
